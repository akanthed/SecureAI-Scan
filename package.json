{
  "name": "secureai-scan",
  "version": "0.6.1",
  "description": "AI security scanner with dataflow evidence — prompt injection, MCP tool poisoning, Agent Skill poisoning, RAG poisoning. Evidence-tiered findings (no false-positive noise by default), SARIF for GitHub code scanning, AI-BOM with OWASP LLM/ASI/MCP Top 10 mapping.",
  "author": "Akshay Kanthed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akanthed/SecureAI-Scan.git"
  },
  "homepage": "https://github.com/akanthed/SecureAI-Scan#readme",
  "bugs": {
    "url": "https://github.com/akanthed/SecureAI-Scan/issues"
  },
  "keywords": [
    "security",
    "sarif",
    "sbom",
    "ai-bom",
    "code-scanning",
    "ai",
    "llm",
    "scanner",
    "cli",
    "typescript",
    "python",
    "prompt-injection",
    "appsec",
    "mcp",
    "rag",
    "vector-database",
    "devsecops",
    "owasp",
    "langchain",
    "openai",
    "agent-security",
    "ai-security",
    "claude",
    "claude-skills",
    "model-context-protocol",
    "tool-poisoning",
    "vulnerability-scanner"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "secureai-scan": "dist/index.js"
  },
  "files": [
    "dist",
    "mcp-server",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "npm run build && node test/run-tests.js",
    "regression": "npm run build && node scripts/regression-scan.js"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^6.0.3",
    "web-tree-sitter": "^0.26.11"
  }
}
